{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH_BASE": "https://api.neargfix.com/auth",
        "EXPO_PUBLIC_TICKET_BASE": "https://api.neargfix.com/ticket",
        "EXPO_PUBLIC_USER_BASE": "https://api.neargfix.com/user",
        "EXPO_PUBLIC_SHOP_BASE": "https://api.neargfix.com/shop",
        "EXPO_PUBLIC_TECHNICIAN_BASE": "https://api.neargfix.com/technician",
        "EXPO_PUBLIC_ORDER_BASE": "https://api.neargfix.com/order",
        "EXPO_PUBLIC_MARKETPLACE_BASE": "https://api.neargfix.com/marketplace",
        "EXPO_PUBLIC_MASTER_DATA_BASE": "https://api.neargfix.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_BASE": "https://api.neargfix.com/auth",
        "EXPO_PUBLIC_TICKET_BASE": "https://api.neargfix.com/ticket",
        "EXPO_PUBLIC_USER_BASE": "https://api.neargfix.com/user",
        "EXPO_PUBLIC_SHOP_BASE": "https://api.neargfix.com/shop",
        "EXPO_PUBLIC_TECHNICIAN_BASE": "https://api.neargfix.com/technician",
        "EXPO_PUBLIC_ORDER_BASE": "https://api.neargfix.com/order",
        "EXPO_PUBLIC_MARKETPLACE_BASE": "https://api.neargfix.com/marketplace",
        "EXPO_PUBLIC_MASTER_DATA_BASE": "https://api.neargfix.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_BASE": "https://api.neargfix.com/auth",
        "EXPO_PUBLIC_TICKET_BASE": "https://api.neargfix.com/ticket",
        "EXPO_PUBLIC_USER_BASE": "https://api.neargfix.com/user",
        "EXPO_PUBLIC_SHOP_BASE": "https://api.neargfix.com/shop",
        "EXPO_PUBLIC_TECHNICIAN_BASE": "https://api.neargfix.com/technician",
        "EXPO_PUBLIC_ORDER_BASE": "https://api.neargfix.com/order",
        "EXPO_PUBLIC_MARKETPLACE_BASE": "https://api.neargfix.com/marketplace",
        "EXPO_PUBLIC_MASTER_DATA_BASE": "https://api.neargfix.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
